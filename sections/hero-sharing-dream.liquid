{{ 'section-hero-sharing-dream.css' | asset_url | stylesheet_tag }}

<section
  id="hero-{{ section.id }}"
  class="hero-sharing-dream"
  style="background-color: {{ section.settings.bg_color }};"
>
  <div class="page-width">
    <div class="hero-sharing-dream__grid">
      <!-- Left Editorial Column -->
      <div class="hero-sharing-dream__content">
        {%- if section.settings.badge_text != blank -%}
          <div class="hero-sharing-dream__badge">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
            </svg>
            <span>{{ section.settings.badge_text }}</span>
          </div>
        {%- endif -%}

        <h1 class="hero-sharing-dream__heading font-serif">
          {{ section.settings.heading }}
        </h1>

        <p class="hero-sharing-dream__text">
          {{ section.settings.text }}
        </p>

        <!-- Tropicfeel-inspired Pill Action Buttons -->
        <div class="hero-sharing-dream__buttons">
          {%- if section.settings.primary_button_label != blank -%}
            <a href="{{ section.settings.primary_button_link }}" class="hero-pill-btn hero-pill-btn--primary">
              <span>{{ section.settings.primary_button_label }}</span>
              <svg
                width="15"
                height="15"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a href="{{ section.settings.secondary_button_link }}" class="hero-pill-btn hero-pill-btn--secondary">
              <span>{{ section.settings.secondary_button_label }}</span>
            </a>
          {%- endif -%}
        </div>

        <!-- Trust Guarantees -->
        <div class="hero-sharing-dream__guarantees">
          <span class="guarantee-item">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#962d3e"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
            </svg>
            Guaranteed Fair Wages
          </span>
          <span class="guarantee-item">
            <svg
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#962d3e"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            30-Day Hassle-Free Returns
          </span>
        </div>
      </div>

      <!-- Right Visual Column -->
      <div class="hero-sharing-dream__media-wrapper">
        <div class="hero-sharing-dream__frame">
          <div class="hero-sharing-dream__image-box">
            {%- if section.settings.hero_image != blank -%}
              {{
                section.settings.hero_image
                | image_url: width: 1200
                | image_tag: class: 'hero-sharing-dream__img', loading: 'eager'
              }}
            {%- else -%}
              <img
                src="{{ 'hero.jpeg' | asset_url }}"
                alt="Maya artisan winding hand-spun cotton thread in Guatemala"
                class="hero-sharing-dream__img"
                width="1000"
                height="800"
                loading="eager"
              >
            {%- endif -%}

            {%- if section.settings.caption != blank -%}
              <div class="hero-sharing-dream__caption">
                <span class="caption-eyebrow">Authentic Heritage</span>
                <p class="caption-text">{{ section.settings.caption }}</p>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Sharing the Dream",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de Fondo",
      "default": "#fcf9f5"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texto del Badge",
      "default": "SHARING THE DREAM • 501(C)(3) FAIR TRADE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título Principal",
      "default": "Authentic Mayan Handcrafts from Lake Atitlán"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Descripción",
      "default": "Handmade jewelry, backstrap-loomed tote bags, and embroidered home decor. Every purchase provides living wages directly to over 120 indigenous weavers and funds youth scholarships in Guatemala."
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Botón Principal (Texto)",
      "default": "Shop Handcrafted Pieces"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Botón Principal (Enlace)",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Botón Secundario (Texto)",
      "default": "Meet the Artisans"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Botón Secundario (Enlace)",
      "default": "#artisans-impact"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Foto Principal del Hero"
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Pie de Foto Editorial",
      "default": "Passing down generations of weaving knowledge in the Guatemalan highlands"
    }
  ],
  "presets": [
    {
      "name": "Hero Sharing the Dream"
    }
  ]
}
{% endschema %}
